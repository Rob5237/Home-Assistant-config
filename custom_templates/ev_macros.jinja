{#
  Macro's voor de EV-planning (packages/ev_load_balancing.yaml).

  ev_dag_blok(n): goedkoopste aaneengesloten laadblok voor 'Morgen thuis blijven'.
    Venster: nu tot 17:00 op de dag van de eerstvolgende vertrektijd (de accu moet dan vol zijn). De auto staat thuis, dus
    het blok mag 's nachts (net) of overdag (zon + net) vallen. Kosten per kwartier:
      kosten = tarief * (1 - zon_aandeel) + zonwaarde * zon_aandeel
    zon_aandeel = deel van het laadvermogen dat uit zonne-overschot kan komen
      = (zonforecast - huisverbruik) / laadvermogen, begrensd op 0..1.
    Zonwaarde (wat je misloopt als je zonnestroom zelf laadt in plaats van terug te leveren):
      - tot input_datetime.ev_lb_saldering_einde (salderingsregeling, Zonneplan-contract): het tarief
        incl. belasting (teruglevering wordt verrekend tegen de afnameprijs) -> zon geeft geen prijsvoordeel
      - daarna (geen saldering): prijs excl. belasting + input_number.ev_lb_terugleveraanpassing, minimaal 0
    Zonforecast: Forecast.Solar-sensoren (3 dakdelen) over zonsopkomst-zonsondergang met een sinusvorm;
    vandaag verdeeld over de resterende daglicht-uren. Huisverbruik: sensor.ev_huisverbruik_24u (gemiddelde
    huislast zonder auto's over 24 uur, vlak).
    Zonneplan-prijs: amount is in 10^-7 EUR/kWh.
  Levert JSON (tojson): start, eind, dl, kosten (EUR/kWh gemiddeld), zon (gemiddeld aandeel 0..1),
    soort ('nacht'/'dag'), nacht {start, kosten}, dag {start, kosten}; leeg ({}) als er geen blok is.
  Caching-valkuil: na een wijziging in dit bestand is een volledige core/restart het zekerst (zie CLAUDE.md).
#}

{%- macro ev_dag_blok(n, nu_test=none) -%}
  {%- set fc = state_attr('sensor.zonneplan_current_quarter_hourly_electricity_tariff', 'forecast') or [] -%}
  {%- set nu = nu_test if nu_test is not none else now() -%}
  {#- Deadline: 17:00 op de dag van de eerstvolgende vertrektijd = de dag na de nacht ('morgen thuis') -#}
  {%- set vt = today_at(states('input_datetime.ev_' ~ n ~ '_vertrek')) -%}
  {%- set vt_volgende = vt if vt > nu else vt + timedelta(days=1) -%}
  {%- set t17 = vt_volgende.replace(hour=17, minute=0, second=0, microsecond=0) -%}
  {#- Laadvermogen (kW) en aantal kwartieren, gelijk aan sensor.ev_<n>_plan_uren -#}
  {%- set f = 3 if is_state('sensor.ev_lb_' ~ n ~ '_fase_actief', '3-fase') else 1 -%}
  {%- if n == 'rob' -%}
    {%- set sonia_aan = states('sensor.ev_sonia_status_connector') in ['Preparing', 'Charging', 'SuspendedEVSE', 'SuspendedEV'] -%}
    {%- set a = states('input_number.ev_lb_deel_max_rob') | float(9) if sonia_aan else states('input_number.ev_lb_max_rob') | float(16) -%}
  {%- else -%}
    {%- set a = states('input_number.ev_lb_deel_max_sonia') | float(13) -%}
  {%- endif -%}
  {%- set p_kw = f * 230 * a / 1000 -%}
  {%- set k = (states('sensor.ev_' ~ n ~ '_plan_uren') | float(0) * 4) | round(0, 'ceil') | int -%}
  {%- set huis_kw = states('sensor.ev_huisverbruik_24u') | float(850) / 1000 -%}
  {#- Zon: zonsopkomst/-ondergang van vandaag (de sensor geeft alleen de eerstvolgende; terugschuiven in hele dagen) -#}
  {%- set rise = state_attr('sun.sun', 'next_rising') | as_datetime | as_local -%}
  {%- set sett = state_attr('sun.sun', 'next_setting') | as_datetime | as_local -%}
  {%- set rise0 = rise - timedelta(days=(rise.date() - nu.date()).days) -%}
  {%- set sett0 = sett - timedelta(days=(sett.date() - nu.date()).days) -%}
  {%- set rest = states('sensor.energy_production_today_remaining') | float(0) + states('sensor.energy_production_today_remaining_2') | float(0) + states('sensor.energy_production_today_remaining_3') | float(0) -%}
  {%- set morgen = states('sensor.energy_production_tomorrow') | float(0) + states('sensor.energy_production_tomorrow_2') | float(0) + states('sensor.energy_production_tomorrow_3') | float(0) -%}
  {%- set einde = states('input_datetime.ev_lb_saldering_einde') | as_datetime | as_local -%}
  {%- set aanpas = states('input_number.ev_lb_terugleveraanpassing') | float(0) -%}
  {%- set ns = namespace(l=[]) -%}
  {%- for q in fc | sort(attribute='start_date') -%}
    {%- set st = as_datetime(q.start_date) | as_local -%}
    {%- set en = as_datetime(q.end_date) | as_local -%}
    {%- if en > nu and en <= t17 -%}
      {%- set p = q.price_tax_included.amount | float(0) / 10000000 -%}
      {%- set pe = q.price_tax_excluded.amount | float(0) / 10000000 -%}
      {%- set mid = st + timedelta(minutes=7.5) -%}
      {#- Zon-vermogen (kW) op het midden van dit kwartier -#}
      {%- set j = (mid.date() - nu.date()).days -%}
      {%- set sr = rise0 + timedelta(days=j) -%}
      {%- set ss = sett0 + timedelta(days=j) -%}
      {%- set dd = (ss - sr).total_seconds() / 3600 -%}
      {%- set x = (mid - sr).total_seconds() / 3600 -%}
      {%- set zon = 0 -%}
      {%- if dd > 1 and 0 < x < dd -%}
        {%- if j == 0 -%}
          {%- set xa = [(nu - sr).total_seconds() / 3600, 0] | max -%}
          {%- set integraal = dd / pi * (cos(pi * xa / dd) + 1) -%}
          {%- if integraal > 0.01 and nu < ss -%}{%- set zon = rest / integraal * sin(pi * x / dd) -%}{%- endif -%}
        {%- elif j == 1 -%}
          {%- set zon = morgen * pi / (2 * dd) * sin(pi * x / dd) -%}
        {%- endif -%}
      {%- endif -%}
      {%- set aandeel = ([[(zon - huis_kw) / p_kw, 0] | max, 1] | min) if p_kw > 0 else 0 -%}
      {%- set waarde = p if st < einde else ([pe + aanpas, 0] | max) -%}
      {%- set kosten = p * (1 - aandeel) + waarde * aandeel -%}
      {%- set ns.l = ns.l + [{'t': st, 'c': kosten, 'a': aandeel}] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set l = ns.l -%}
  {%- set b = namespace(alle=none, nacht=none, dag=none) -%}
  {%- if k > 0 -%}
    {%- for i in range(0, l | count - k + 1) -%}
      {%- if (l[i + k - 1].t - l[i].t).total_seconds() == (k - 1) * 900 -%}
        {%- set blok = l[i:i + k] -%}
        {%- set som = blok | sum(attribute='c') -%}
        {%- set zsom = blok | sum(attribute='a') -%}
        {%- set eind_blok = l[i + k - 1].t + timedelta(minutes=15) -%}
        {#- 'nacht' = blok eindigt vóór de vertrektijd; anders 'dag' (de dag na de nacht) -#}
        {%- set is_nacht = eind_blok <= vt_volgende -%}
        {%- set item = {'start': l[i].t.isoformat(), 'eind': eind_blok.isoformat(), 'kosten': (som / k) | round(4), 'zon': (zsom / k) | round(2), 'soort': 'nacht' if is_nacht else 'dag'} -%}
        {%- if b.alle is none or som / k < b.alle.kosten -%}{%- set b.alle = item -%}{%- endif -%}
        {%- if is_nacht and (b.nacht is none or som / k < b.nacht.kosten) -%}{%- set b.nacht = item -%}{%- endif -%}
        {%- if not is_nacht and (b.dag is none or som / k < b.dag.kosten) -%}{%- set b.dag = item -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if b.alle is none -%}
    {{- {} | tojson -}}
  {%- else -%}
    {{- dict(b.alle, dl=t17.isoformat(), nacht=({'start': b.nacht.start, 'kosten': b.nacht.kosten, 'zon': b.nacht.zon} if b.nacht is not none else {}), dag=({'start': b.dag.start, 'kosten': b.dag.kosten, 'zon': b.dag.zon} if b.dag is not none else {})) | tojson -}}
  {%- endif -%}
{%- endmacro %}
