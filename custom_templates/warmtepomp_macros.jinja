{#
  Gedeelde macros voor de warmtepomp-templates (templates/warmtepomp.yaml).

  Achtergrond: het sensor.warmtepomp_optimaal_startuur template berekent voor
  state, kosten_per_kwh_warmte en uurlijks_overzicht steeds dezelfde
  prijzen × weer lus met stooklijn- en COP-berekening. Deze macros centraliseren
  die logica zodat formule-aanpassingen op één plek gebeuren.

  COP-model: Carnot × 0.4 met clamp [1.5, 6.0]; lift = max(1, t_aanvoer - t_buiten).
  Stooklijn: lineair van t_aanvoer_min @ t_drempel tot t_aanvoer_max @ -10°C,
  clamped op beide uiteinden.
  Zonneplan-prijs: p.electricity_price is in 10^-7 €/kWh → /10000000 = €/kWh.
#}

{%- macro stooklijn_aanvoer(t_buiten, t_min, t_max, t_drempel) -%}
  {%- set helling = (t_max - t_min) / (t_drempel - (-10)) -%}
  {{ [[t_min, t_min + helling * (t_drempel - t_buiten)] | max, t_max] | min }}
{%- endmacro %}

{%- macro cop(t_aanvoer, t_buiten) -%}
  {%- set lift = [1, t_aanvoer - t_buiten] | max -%}
  {{ [[1.5, 0.4 * (t_aanvoer + 273) / lift] | max, 6.0] | min }}
{%- endmacro %}

{%- macro kosten_warmte(prijs_raw, cop_val) -%}
  {{ (prijs_raw | float(3000000)) / 10000000 / cop_val }}
{%- endmacro %}

{#
  bereken_uren: itereert prijzen × weer en levert een lijst dicts terug
  (één per toekomstig uur waarvoor zowel prijs als weer beschikbaar zijn).
  Output via tojson zodat de aanroeper `| from_json` kan toepassen en daarna
  Jinja-filters als `min(attribute='kosten_warmte')` kan inzetten.

  Velden per uur:
    dag           - 'YYYY-MM-DD' (voor groepering)
    uur           - int hour 0-23
    label         - 'dd-mm HH:MM' (display)
    temp          - buitentemp °C, rond 1
    aanvoer       - stooklijn-aanvoertemp °C, rond 1
    cop_geschat   - geschatte COP, rond 2
    prijs         - €/kWh, rond 4
    kosten_warmte - €/kWh warmte (prijs/cop), rond 4
#}
{%- macro bereken_uren(prijzen, weer, t_min, t_max, t_drempel) -%}
  {%- set helling = (t_max - t_min) / (t_drempel - (-10)) -%}
  {%- set ns = namespace(uren=[]) -%}
  {%- for p in prijzen -%}
    {%- set p_dt = as_datetime(p.datetime) | as_local -%}
    {%- if p_dt + timedelta(hours=1) > now() -%}
      {%- for w in weer -%}
        {%- set w_dt = as_datetime(w.datetime) | as_local -%}
        {%- if w_dt.date() == p_dt.date() and w_dt.hour == p_dt.hour -%}
          {%- set t = w.temperature | float(10) -%}
          {%- set t_a = [[t_min, t_min + helling * (t_drempel - t)] | max, t_max] | min -%}
          {%- set lift = [1, t_a - t] | max -%}
          {%- set c = [[1.5, 0.4 * (t_a + 273) / lift] | max, 6.0] | min -%}
          {%- set prijs_eur = (p.electricity_price | float(3000000)) / 10000000 -%}
          {%- set k = prijs_eur / c -%}
          {%- set ns.uren = ns.uren + [{
            'dag': p_dt.strftime('%Y-%m-%d'),
            'uur': p_dt.hour,
            'label': p_dt.strftime('%d-%m %H:%M'),
            'temp': t | round(1),
            'aanvoer': t_a | round(1),
            'cop_geschat': c | round(2),
            'prijs': prijs_eur | round(4),
            'kosten_warmte': k | round(4)
          }] -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  {{ ns.uren | tojson }}
{%- endmacro %}

{#
  bereken_kwartieren: kwartier-precisie variant van bereken_uren. Zonneplan
  publiceert prijzen per 15 minuten (sensor.zonneplan_current_quarter_hourly_
  electricity_tariff, attribuut forecast) — andere structuur dan de uur-
  sensor: start_date/end_date i.p.v. datetime, price_tax_included.amount
  i.p.v. electricity_price. Buitentemp blijft per uur (weather.thuis geeft
  geen kwartier-forecast) — alle 4 kwartieren binnen een uur delen dezelfde
  temp/aanvoer/COP, alleen de prijs varieert per kwartier.
  Output: zelfde velden als bereken_uren plus 'kwartier' (0/15/30/45).
#}
{%- macro bereken_kwartieren(prijzen_kw, weer, t_min, t_max, t_drempel) -%}
  {%- set helling = (t_max - t_min) / (t_drempel - (-10)) -%}
  {%- set ns = namespace(uren=[]) -%}
  {%- for p in prijzen_kw -%}
    {%- set p_start = as_datetime(p.start_date) | as_local -%}
    {%- set p_end = as_datetime(p.end_date) | as_local -%}
    {%- if p_end > now() -%}
      {%- set m = namespace(t=none) -%}
      {%- for w in weer -%}
        {%- set w_dt = as_datetime(w.datetime) | as_local -%}
        {%- if w_dt.date() == p_start.date() and w_dt.hour == p_start.hour -%}
          {%- set m.t = w.temperature | float(10) -%}
        {%- endif -%}
      {%- endfor -%}
      {#- weather.get_forecasts (hourly) geeft alleen nog niet-begonnen uren;
          het huidige, nog lopende uur ontbreekt daardoor zodra het begint —
          val dan terug op de live buitentemp i.p.v. dit kwartier te laten
          verdwijnen (anders mist de middagbuffer precies het laatste,
          lopende uur van zijn venster, bevestigd 14-10-2026). -#}
      {%- if m.t is none and p_start.date() == now().date() and p_start.hour == now().hour -%}
        {%- set m.t = states('sensor.luxtronik_280807_0450_outdoor_temperature') | float(none) -%}
      {%- endif -%}
      {%- if m.t is not none -%}
        {%- set t = m.t -%}
        {%- set t_a = [[t_min, t_min + helling * (t_drempel - t)] | max, t_max] | min -%}
        {%- set lift = [1, t_a - t] | max -%}
        {%- set c = [[1.5, 0.4 * (t_a + 273) / lift] | max, 6.0] | min -%}
        {%- set prijs_eur = (p.price_tax_included.amount | float(3000000)) / 10000000 -%}
        {%- set k = prijs_eur / c -%}
        {%- set ns.uren = ns.uren + [{
          'dag': p_start.strftime('%Y-%m-%d'),
          'uur': p_start.hour,
          'kwartier': p_start.minute,
          'label': p_start.strftime('%d-%m %H:%M'),
          'temp': t | round(1),
          'aanvoer': t_a | round(1),
          'cop_geschat': c | round(2),
          'prijs': prijs_eur | round(4),
          'kosten_warmte': k | round(4)
        }] -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {{ ns.uren | tojson }}
{%- endmacro %}

{#
  bereken_tdi_uren: vindt de eerste dag waarop een TDI-cyclus mag plaatsvinden
  (tdi_dagen_offset + dagen_vooruit >= 7) en levert de uren 09-16 van die dag
  als JSON-lijst, met vaste aanvoertemperatuur 65°C.

  Velden per uur: dag, uur, label, cop_geschat, prijs, kosten_warmte
  (geen 'temp' / 'aanvoer' — TDI-aanvoer is constant 65°C).
#}
{%- macro bereken_tdi_uren(prijzen, weer, tdi_dagen) -%}
  {%- set t_aanvoer_tdi = 65 -%}
  {%- set ns = namespace(eerste_dag=none) -%}
  {%- for p in prijzen -%}
    {%- set p_dt = as_datetime(p.datetime) | as_local -%}
    {%- if p_dt + timedelta(hours=1) > now() and 9 <= p_dt.hour < 16 and ns.eerste_dag is none -%}
      {%- if tdi_dagen + (p_dt.date() - now().date()).days >= 7 -%}
        {%- set ns.eerste_dag = p_dt.strftime('%Y-%m-%d') -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set ns2 = namespace(uren=[]) -%}
  {%- if ns.eerste_dag is not none -%}
    {%- for p in prijzen -%}
      {%- set p_dt = as_datetime(p.datetime) | as_local -%}
      {%- if p_dt.strftime('%Y-%m-%d') == ns.eerste_dag and 9 <= p_dt.hour < 16 -%}
        {%- for w in weer -%}
          {%- set w_dt = as_datetime(w.datetime) | as_local -%}
          {%- if w_dt.date() == p_dt.date() and w_dt.hour == p_dt.hour -%}
            {%- set t = w.temperature | float(10) -%}
            {%- set lift = [1, t_aanvoer_tdi - t] | max -%}
            {%- set c = [[1.5, 0.4 * (t_aanvoer_tdi + 273) / lift] | max, 6.0] | min -%}
            {%- set prijs_eur = (p.electricity_price | float(3000000)) / 10000000 -%}
            {%- set k = prijs_eur / c -%}
            {%- set ns2.uren = ns2.uren + [{
              'dag': p_dt.strftime('%Y-%m-%d'),
              'uur': p_dt.hour,
              'label': p_dt.strftime('%d-%m %H:%M'),
              'cop_geschat': c | round(2),
              'prijs': prijs_eur | round(4),
              'kosten_warmte': k | round(4)
            }] -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {{ ns2.uren | tojson }}
{%- endmacro %}

{#
  bereken_tdi_kwartieren: kwartier-precisie variant van bereken_tdi_uren,
  zelfde dag-selectielogica (eerste dag waarop tdi_dagen + dagen_vooruit >=
  7), maar daarna alle kwartieren binnen 09:00-16:00 van die dag i.p.v. hele
  uren. Zie bereken_kwartieren voor de forecast-structuurverschillen.
#}
{%- macro bereken_tdi_kwartieren(prijzen_kw, weer, tdi_dagen) -%}
  {%- set t_aanvoer_tdi = 65 -%}
  {%- set ns = namespace(eerste_dag=none) -%}
  {%- for p in prijzen_kw -%}
    {%- set p_start = as_datetime(p.start_date) | as_local -%}
    {%- set p_end = as_datetime(p.end_date) | as_local -%}
    {%- if p_end > now() and 9 <= p_start.hour < 16 and ns.eerste_dag is none -%}
      {%- if tdi_dagen + (p_start.date() - now().date()).days >= 7 -%}
        {%- set ns.eerste_dag = p_start.strftime('%Y-%m-%d') -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set ns2 = namespace(uren=[]) -%}
  {%- if ns.eerste_dag is not none -%}
    {%- for p in prijzen_kw -%}
      {%- set p_start = as_datetime(p.start_date) | as_local -%}
      {%- if p_start.strftime('%Y-%m-%d') == ns.eerste_dag and 9 <= p_start.hour < 16 -%}
        {%- set m = namespace(t=none) -%}
        {%- for w in weer -%}
          {%- set w_dt = as_datetime(w.datetime) | as_local -%}
          {%- if w_dt.date() == p_start.date() and w_dt.hour == p_start.hour -%}
            {%- set m.t = w.temperature | float(10) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if m.t is none and p_start.date() == now().date() and p_start.hour == now().hour -%}
          {%- set m.t = states('sensor.luxtronik_280807_0450_outdoor_temperature') | float(none) -%}
        {%- endif -%}
        {%- if m.t is not none -%}
          {%- set t = m.t -%}
          {%- set lift = [1, t_aanvoer_tdi - t] | max -%}
          {%- set c = [[1.5, 0.4 * (t_aanvoer_tdi + 273) / lift] | max, 6.0] | min -%}
          {%- set prijs_eur = (p.price_tax_included.amount | float(3000000)) / 10000000 -%}
          {%- set k = prijs_eur / c -%}
          {%- set ns2.uren = ns2.uren + [{
            'dag': p_start.strftime('%Y-%m-%d'),
            'uur': p_start.hour,
            'kwartier': p_start.minute,
            'label': p_start.strftime('%d-%m %H:%M'),
            'cop_geschat': c | round(2),
            'prijs': prijs_eur | round(4),
            'kosten_warmte': k | round(4)
          }] -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {{ ns2.uren | tojson }}
{%- endmacro %}

{#
  bepaal_middag_venster: zoekt het eerstvolgende moment waarop het pre-17-
  vloerbuffer-venster openstaat — vandaag als dat nog kan, anders morgen
  (en zo verder), nooit "onbekend" zolang er ergens in de beschikbare
  prijs-horizon (via `uren`, output van bereken_kwartieren) nog een dag met
  een geldig venster zit. Zonneplan publiceert day-ahead, dus "morgen" is al
  net zo goed bekend als "vandaag" — geen reden om tot morgenochtend te
  wachten met vooruitkijken.

  Elke dag heeft zijn eigen middag_start_uur, dat afhangt van de
  buitentemp rond het middaguur — voor vandaag de live sensor, voor
  toekomstige dagen de weersverwachting op 14:00 lokale tijd van die dag
  (ruwe schatting van "rond het middaguur", maar wel met echte voorspelde
  data i.p.v. een slag in de lucht).

  Input `uren` moet al door bereken_kwartieren berekend zijn (COP/aanvoer
  zijn al ingerekend); deze macro doet alleen de venster-selectie, niet de
  stooklijn-berekening zelf (die heeft t_min/t_max/t_drempel nodig die hier
  niet beschikbaar zijn).

  Retourneert JSON: {gevonden, dag, middag_start_uur, uur, kwartier,
  kosten_warmte, label} of {gevonden: false} als zelfs de verste dag in de
  prijs-horizon geen geldig venster oplevert (zou feitelijk nooit moeten
  gebeuren met de huidige ~32-57 uur vooruitkijkende Zonneplan-forecast).
#}
{%- macro bepaal_middag_venster(uren, weer, t_drempel) -%}
  {#- Bovengrens-fix (15-10-2026): het venster liep voorheen door tot 17:00
     zelf, waardoor een kwartier vlak vóór 17:00 (bv. 16:45) als "goedkoopste"
     gekozen kon worden terwijl er dan geen tijd meer over is om echt op te
     warmen. laatste_start_uur is een voorzichtige, NIET-gekalibreerde
     ondergrens voor de benodigde opwarmtijd (vloerverwarming is traag, ook
     bij mild weer) — zie CLAUDE.md "Kwartierprecisie"/aanvoer-traagheid
     voor de aantekening dat dit later vervangen moet worden door een echt
     model zodra er meetdata is (aanvoer−retour-delta × tijd vs. ΔT). -#}
  {%- set dagen = uren | map(attribute='dag') | unique | sort | list -%}
  {%- set ns = namespace(resultaat=none) -%}
  {%- for dag in dagen -%}
    {%- if ns.resultaat is none -%}
      {%- if dag == now().strftime('%Y-%m-%d') -%}
        {%- set t_mid = states('sensor.luxtronik_280807_0450_outdoor_temperature') | float(10) -%}
      {%- else -%}
        {%- set ns2 = namespace(t=10) -%}
        {%- for w in weer -%}
          {%- set w_dt = as_datetime(w.datetime) | as_local -%}
          {%- if w_dt.strftime('%Y-%m-%d') == dag and w_dt.hour == 14 -%}
            {%- set ns2.t = w.temperature | float(10) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- set t_mid = ns2.t -%}
      {%- endif -%}
      {%- set uren_vooraf = [[5, 5 + (t_drempel - t_mid) / 8] | max, 8] | min -%}
      {%- set uren_vooraf_min = [[2, 2 + (t_drempel - t_mid) / 16] | max, 4] | min -%}
      {%- set msu = (17 - uren_vooraf) | round | int -%}
      {%- set laatste_start_uur = (17 - uren_vooraf_min) | round | int -%}
      {%- set middag = uren | selectattr('dag', 'equalto', dag) | selectattr('uur', 'ge', msu) | selectattr('uur', 'lt', laatste_start_uur) | list -%}
      {%- if middag -%}
        {#- Vaste looptijd (26-10-2026): de buffer draait looptijd_uren uur (3 uur
           bij mild weer, oplopend tot 4 uur bij kou; NIET gekalibreerd) en stopt
           daarna zelf (warmtepomp_pre17_buffer_einde_looptijd). Kies het
           aaneengesloten blok van die lengte, binnen het venster en uiterlijk
           klaar om 17:00, met het laagste gemiddelde kosten_warmte. -#}
        {%- set looptijd_uren = [[3, 3 + (t_drempel - t_mid) / 8] | max, 4] | min -%}
        {%- set nkw = ((looptijd_uren * 60) / 15) | round | int -%}
        {%- set looptijd_min = nkw * 15 -%}
        {#- Tapwatercycli (26-10-2026): de warmtepomp verwarmt dan tapwater met
           voorrang en de vloer krijgt in die tijd niets. Twee verwachte gebeurtenissen:
           (1) de legionella-cyclus (TDI, 60 min) op het kandidaat-kwartier van de dag
           waarop hij aan de beurt is; (2) een gewone tapwatercyclus (45 min) zodra de
           boiler volgens de gemiddelde daling (0,45 °C/uur, NIET gekalibreerd) onder
           46 °C komt (alleen voor vandaag). Valt een gebeurtenis in het bufferblok,
           dan wordt het blok zo lang langer; de kwartieren van de gebeurtenis tellen
           niet mee in de prijs en een start tijdens de gebeurtenis is uitgesloten.
           Valt de TDI eerder dan de gewone cyclus, dan verwarmt de TDI de boiler al
           en vervalt de gewone cyclus. -#}
        {%- set tdi_s = states('input_datetime.tdi_laatste_start') -%}
        {%- set tdi_dagen = (now().date() - (as_datetime(tdi_s) | as_local).date()).days if tdi_s not in ('unknown', 'unavailable') else 999 -%}
        {%- set tdi_prijzen = state_attr('sensor.zonneplan_current_quarter_hourly_electricity_tariff', 'forecast') -%}
        {%- set tdi_lijst = (bereken_tdi_kwartieren(tdi_prijzen, weer, tdi_dagen) | from_json) if tdi_prijzen else [] -%}
        {%- set tdi_best = (tdi_lijst | min(attribute='kosten_warmte')) if tdi_lijst else none -%}
        {%- set tdi_min = (tdi_best.uur * 60 + tdi_best.kwartier) if (tdi_best is not none and tdi_best.dag == dag) else -1 -%}
        {%- set ev = namespace(l=[]) -%}
        {%- if tdi_min >= 0 -%}
          {%- set ev.l = ev.l + [{'s': tdi_min, 'd': 60}] -%}
        {%- endif -%}
        {%- if dag == now().strftime('%Y-%m-%d') -%}
          {%- set dhw_nu = states('sensor.luxtronik_280807_0450_dhw_temperature') | float(none) -%}
          {%- if dhw_nu is not none -%}
            {%- set nu_min = now().hour * 60 + now().minute -%}
            {%- set tw_s = nu_min + ((((dhw_nu - 46) / 0.45) * 60) | round | int if dhw_nu > 46 else 5) -%}
            {%- if tw_s < 1020 and not (tdi_min >= 0 and tdi_min <= tw_s) -%}
              {%- set ev.l = ev.l + [{'s': (tw_s // 15) * 15, 'd': 45}] -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
        {%- set dag_uren = uren | selectattr('dag', 'equalto', dag) | list -%}
        {%- set nb = namespace(best=none, best_gem=none, ext=0, cands=[]) -%}
        {%- for kand in middag -%}
          {%- set k0 = kand.uur * 60 + kand.kwartier -%}
          {%- set cd = namespace(ext=0, tijdens=false) -%}
          {%- for e in ev.l -%}
            {%- if k0 <= e.s and e.s < k0 + looptijd_min -%}
              {%- set cd.ext = cd.ext + e.d -%}
            {%- endif -%}
            {%- if k0 > e.s and k0 < e.s + e.d -%}
              {%- set cd.tijdens = true -%}
            {%- endif -%}
          {%- endfor -%}
          {%- set eff_min = looptijd_min + cd.ext -%}
          {%- if k0 + eff_min <= 1020 and not cd.tijdens -%}
            {%- set ns3 = namespace(som=0, n=0) -%}
            {%- for q in dag_uren -%}
              {%- set qm = q.uur * 60 + q.kwartier -%}
              {%- set in_ev = namespace(v=false) -%}
              {%- for e in ev.l -%}
                {%- if k0 <= e.s and e.s < k0 + looptijd_min and qm >= e.s and qm < e.s + e.d -%}
                  {%- set in_ev.v = true -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if qm >= k0 and qm < k0 + eff_min and not in_ev.v -%}
                {%- set ns3.som = ns3.som + q.kosten_warmte -%}
                {%- set ns3.n = ns3.n + 1 -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if ns3.n == nkw -%}
              {%- set nb.cands = nb.cands + [{'kand': kand, 'k0': k0, 'gem': ns3.som / ns3.n, 'ext': cd.ext}] -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {#- Voorkeur voor een laat einde (26-10-2026): de vloer geeft de opgeslagen
           warmte in de avond af, dus kies van de blokken waarvan het gemiddelde
           niet meer dan marge (5%, NIET gekalibreerd) boven het goedkoopste ligt
           de LAATSTE start. -#}
        {%- if nb.cands -%}
          {%- set gem_min = nb.cands | map(attribute='gem') | min -%}
          {%- set grens = gem_min + (gem_min | abs) * 0.05 -%}
          {%- set ok = nb.cands | selectattr('gem', 'le', grens) | sort(attribute='k0') | list -%}
          {%- set keuze = ok | last -%}
          {%- set nb.best = keuze.kand -%}
          {%- set nb.best_gem = keuze.gem -%}
          {%- set nb.ext = keuze.ext -%}
        {%- endif -%}
        {%- set best = nb.best if nb.best is not none else (middag | min(attribute='kosten_warmte')) -%}
        {%- set ns.resultaat = {
          'gevonden': true,
          'dag': dag,
          'middag_start_uur': msu,
          'laatste_start_uur': laatste_start_uur,
          'uur': best.uur,
          'kwartier': best.kwartier,
          'looptijd_uren': ((looptijd_min + nb.ext) / 60) | round(2),
          'tapwater_verlenging_min': nb.ext,
          'kosten_warmte': (nb.best_gem | round(4)) if nb.best_gem is not none else best.kosten_warmte,
          'label': best.label
        } -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {{ (ns.resultaat if ns.resultaat is not none else {'gevonden': false}) | tojson }}
{%- endmacro %}

{#
  bereken_dhw_kwartieren: zelfde idee als bereken_kwartieren, maar voor
  tapwater (boiler) i.p.v. CV — geen stooklijn (die is CV-specifiek), de
  aanvoertemp is hier gewoon het vaste DHW-setpoint van de cyclus (57°C
  nachtcyclus, 65°C TDI). Zelfde live-buitentemp-fallback voor het lopende
  uur als bereken_kwartieren (weather.get_forecasts mist het huidige uur
  zodra het begint). Output bevat ook 'start'/'einde' (ISO) zodat de
  aanroeper kan checken of "nu" binnen het beste kwartier-interval valt.
#}
{%- macro bereken_dhw_kwartieren(prijzen_kw, weer, t_aanvoer_vast) -%}
  {%- set ns = namespace(uren=[]) -%}
  {%- for p in prijzen_kw -%}
    {%- set p_start = as_datetime(p.start_date) | as_local -%}
    {%- set p_end = as_datetime(p.end_date) | as_local -%}
    {%- if p_end > now() -%}
      {%- set m = namespace(t=none) -%}
      {%- for w in weer -%}
        {%- set w_dt = as_datetime(w.datetime) | as_local -%}
        {%- if w_dt.date() == p_start.date() and w_dt.hour == p_start.hour -%}
          {%- set m.t = w.temperature | float(10) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if m.t is none and p_start.date() == now().date() and p_start.hour == now().hour -%}
        {%- set m.t = states('sensor.luxtronik_280807_0450_outdoor_temperature') | float(none) -%}
      {%- endif -%}
      {%- if m.t is not none -%}
        {%- set t = m.t -%}
        {%- set lift = [1, t_aanvoer_vast - t] | max -%}
        {%- set c = [[1.5, 0.4 * (t_aanvoer_vast + 273) / lift] | max, 6.0] | min -%}
        {%- set prijs_eur = (p.price_tax_included.amount | float(3000000)) / 10000000 -%}
        {%- set k = prijs_eur / c -%}
        {%- set ns.uren = ns.uren + [{
          'dag': p_start.strftime('%Y-%m-%d'),
          'uur': p_start.hour,
          'kwartier': p_start.minute,
          'label': p_start.strftime('%d-%m %H:%M'),
          'start': p_start.isoformat(),
          'einde': p_end.isoformat(),
          'cop_geschat': c | round(2),
          'prijs': prijs_eur | round(4),
          'kosten_warmte': k | round(4)
        }] -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {{ ns.uren | tojson }}
{%- endmacro %}

{#
  beste_nachtmoment: zoekt het goedkoopste kwartier binnen de ÉÉN
  eerstvolgende/lopende nachtvenster (22:00-06:00), niet over meerdere
  nachten heen. Puur op hour-of-day filteren (uur in [22,23,0..5]) over de
  hele ~32-57 uur prijs-horizon zou per ongeluk twee verschillende nachten
  samenvoegen en de goedkoopste van de VERKEERDE nacht kunnen kiezen — dit
  bakent daarom expliciet de datetime-grenzen van precies één nachtvenster
  af (22:00 vandaag t/m 06:00 morgen, of — als het nu al na middernacht is
  — 22:00 gisteren t/m 06:00 vandaag).
  Input `uren` = output van bereken_dhw_kwartieren. Retourneert JSON:
  {gevonden, start, einde, kosten_warmte, label} of {gevonden: false}.
#}
{%- macro beste_nachtmoment(uren) -%}
  {%- set referentie = now() if now().hour >= 6 else (now() - timedelta(days=1)) -%}
  {%- set venster_start = referentie.replace(hour=22, minute=0, second=0, microsecond=0) -%}
  {%- set venster_eind = venster_start + timedelta(hours=8) -%}
  {%- set ns = namespace(resultaat=none) -%}
  {%- for u in uren -%}
    {%- set u_start = as_datetime(u.start) -%}
    {%- if u_start >= venster_start and u_start < venster_eind -%}
      {%- if ns.resultaat is none or u.kosten_warmte < ns.resultaat.kosten_warmte -%}
        {%- set ns.resultaat = u -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if ns.resultaat is not none -%}
    {{ {'gevonden': true, 'start': ns.resultaat.start, 'einde': ns.resultaat.einde, 'kosten_warmte': ns.resultaat.kosten_warmte, 'label': ns.resultaat.label} | tojson }}
  {%- else -%}
    {{ {'gevonden': false} | tojson }}
  {%- endif -%}
{%- endmacro %}
