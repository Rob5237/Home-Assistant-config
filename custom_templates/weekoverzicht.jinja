{#
  Macro's voor het weekoverzicht (packages/weekoverzicht.yaml).

  wv(per, e): waarde van een week-meter. per = 'nu' (lopende week, ma 00:00 tot nu) of
    'vorige' (afgelopen volledige week, attribuut last_period van de utility_meter).
  week(per): alle kerncijfers van één week als JSON (tojson). Ontbrekende of onmogelijke
    cijfers (deling door nul) zijn null.
  bericht(per): leesbare tekst (regels met '- ') voor het dashboard en de telefoonmelding.

  Zonneplan-bedragen komen uit de sensoren 'dit jaar' (monotoon stijgend, geen dagreset), de kosten per
  verbruiker uit de tellers sensor.week_teller_* (aantal kWh-wijziging x kwartiertarief incl. belasting).
  Enphase meldt MWh: opwek in kWh = MWh x 1000 (resolutie van de teller: zie CLAUDE.md).
  Na een wijziging in dit bestand: volledige core/restart (zie caching-valkuil in CLAUDE.md).
#}
{%- macro wv(per, e) -%}
  {%- set s = state_attr(e, 'last_period') if per == 'vorige' else states(e) -%}
  {{- s | float(0) -}}
{%- endmacro -%}

{%- macro week(per) -%}
  {%- set sfx = '_vorige' if per == 'vorige' else '_nu' -%}
  {%- set afname = wv(per, 'sensor.week_afname_kwh') | float(0) -%}
  {%- set terug = wv(per, 'sensor.week_teruglevering_kwh') | float(0) -%}
  {%- set opwek = wv(per, 'sensor.week_opwek') | float(0) * 1000 -%}
  {%- set verbruik = afname + opwek - terug -%}
  {%- set zelf = [opwek - terug, 0] | max -%}
  {%- set afname_eur = wv(per, 'sensor.week_afname_eur') | float(0) -%}
  {%- set terug_eur = wv(per, 'sensor.week_teruglevering_eur') | float(0) -%}
  {%- set netto = afname_eur - terug_eur -%}
  {%- set inkoop = (afname_eur / afname) if afname > 1 else none -%}
  {%- set markt_n = wv(per, 'sensor.week_markt_n') | float(0) -%}
  {%- set markt = (wv(per, 'sensor.week_markt_som') | float(0) / markt_n) if markt_n > 0 else none -%}
  {%- set voordeel = ((markt - inkoop) / markt * 100) if (markt and inkoop is not none and markt > 0) else none -%}
  {#- Warmtepomp -#}
  {%- set wp_in = wv(per, 'sensor.week_wp_input_verw') | float(0) + wv(per, 'sensor.week_wp_input_tap') | float(0) -%}
  {%- set wp_warmte = wv(per, 'sensor.week_wp_warmte_verw') | float(0) + wv(per, 'sensor.week_wp_warmte_tap') | float(0) -%}
  {%- set wp_kosten = wv(per, 'sensor.week_kosten_wp') | float(0) -%}
  {%- set wp_prijs = (wp_kosten / wp_in) if wp_in > 1 else none -%}
  {%- set wp_voordeel = ((markt - wp_prijs) / markt * 100) if (markt and wp_prijs is not none and markt > 0) else none -%}
  {#- EV -#}
  {%- set rob_kwh = wv(per, 'sensor.week_ev_rob') | float(0) -%}
  {%- set rob_kosten = wv(per, 'sensor.week_kosten_rob') | float(0) -%}
  {%- set rob_prijs = (rob_kosten / rob_kwh) if rob_kwh > 0.5 else none -%}
  {%- set rob_voordeel = ((markt - rob_prijs) / markt * 100) if (markt and rob_prijs is not none and markt > 0) else none -%}
  {%- set sonia_kwh = wv(per, 'sensor.week_ev_sonia') | float(0) -%}
  {%- set sonia_kosten = wv(per, 'sensor.week_kosten_sonia') | float(0) -%}
  {%- set sonia_prijs = (sonia_kosten / sonia_kwh) if sonia_kwh > 0.5 else none -%}
  {%- set sonia_voordeel = ((markt - sonia_prijs) / markt * 100) if (markt and sonia_prijs is not none and markt > 0) else none -%}
  {#- Scenario zonder saldering: teruglevering tegen prijs excl. belasting + aanpassing -#}
  {%- set waarde_2027 = wv(per, 'sensor.week_waarde_teruglevering_2027') | float(0) -%}
  {%- set netto_2027 = afname_eur - waarde_2027 -%}
  {#- Compressor en comfort (history_stats over dezelfde week) -#}
  {%- set starts = states('sensor.week_compressorstarts' ~ sfx) | float(0) -%}
  {%- set uren = states('sensor.week_compressor_uren' ~ sfx) | float(0) -%}
  {%- set maandag = (now().replace(hour=0, minute=0, second=0, microsecond=0) - timedelta(days=now().weekday() + (7 if per == 'vorige' else 0))) -%}
  {{- {
    'van': maandag.strftime('%d-%m'),
    'tot': (maandag + timedelta(days=6)).strftime('%d-%m'),
    'afname_kwh': afname | round(1),
    'teruglevering_kwh': terug | round(1),
    'opwek_kwh': opwek | round(1),
    'verbruik_kwh': verbruik | round(1),
    'zelfverbruik_kwh': zelf | round(1),
    'zelfverbruik_pct': ((zelf / opwek * 100) | round(0)) if opwek > 1 else none,
    'zelfvoorzienend_pct': ((zelf / verbruik * 100) | round(0)) if verbruik > 1 else none,
    'afname_eur': afname_eur | round(2),
    'teruglevering_eur': terug_eur | round(2),
    'netto': netto | round(2),
    'inkoopprijs': inkoop | round(3) if inkoop is not none else none,
    'marktprijs': markt | round(3) if markt is not none else none,
    'voordeel_pct': voordeel | round(1) if voordeel is not none else none,
    'wp_kwh': wp_in | round(1),
    'wp_cop': ((wp_warmte / wp_in) | round(2)) if wp_in > 1 else none,
    'wp_prijs': wp_prijs | round(3) if wp_prijs is not none else none,
    'wp_voordeel_pct': wp_voordeel | round(1) if wp_voordeel is not none else none,
    'element_kwh_warmte': wv(per, 'sensor.week_element_warmte') | float(0) | round(1),
    'rob_kwh': rob_kwh | round(1),
    'rob_prijs': rob_prijs | round(3) if rob_prijs is not none else none,
    'rob_voordeel_pct': rob_voordeel | round(1) if rob_voordeel is not none else none,
    'sonia_kwh': sonia_kwh | round(1),
    'sonia_prijs': sonia_prijs | round(3) if sonia_prijs is not none else none,
    'sonia_voordeel_pct': sonia_voordeel | round(1) if sonia_voordeel is not none else none,
    'netto_zonder_saldering': netto_2027 | round(2),
    'meerkosten_zonder_saldering': (netto_2027 - netto) | round(2),
    'compressor_starts': starts | round(0),
    'compressor_uren': uren | round(1),
    'compressor_gem_run_min': ((uren * 60 / starts) | round(0)) if starts > 0 else none,
    'kamer_te_koud_pct': states('sensor.week_kamer_te_koud' ~ sfx) | float(0) | round(1),
    'boiler_laagste_7d': states('sensor.week_boiler_laagste_7_dagen') | float(none)
  } | tojson -}}
{%- endmacro -%}

{#- f(x, d, eenheid): getal met komma, 'n.v.' als er geen waarde is -#}
{%- macro f(x, d=2, eh='') -%}
  {%- if x is none -%}n.v.{%- else -%}{{ (('%.' ~ d ~ 'f') | format(x | float(0))) | replace('.', ',') }}{{ eh }}{%- endif -%}
{%- endmacro -%}

{#- EV-regels: label en getal opgevuld met (cijferbreedte-)spaties zodat de komma's van de kWh onder elkaar
    staan; in een gewoon (niet-vaste-breedte) lettertype is dat een benadering. -#}
{%- macro bericht(per) -%}
  {%- set d = week(per) | from_json -%}
  {%- set ka = f(d.rob_kwh, 1) | trim -%}
  {%- set kb = f(d.sonia_kwh, 1) | trim -%}
  {%- set pr = '€ ' ~ (f(d.rob_prijs, 3) | trim) ~ ' (' ~ (f(d.rob_voordeel_pct, 1, ' %') | trim) ~ ')' -%}
  {%- set ps = '€ ' ~ (f(d.sonia_prijs, 3) | trim) ~ ' (' ~ (f(d.sonia_voordeel_pct, 1, ' %') | trim) ~ ')' -%}
  {%- set w = [ka | length, kb | length] | max -%}
  {%- set fs = ' ' -%}
  {%- set ev_blok = '  - EV Rob:\u00a0\u00a0\u00a0' ~ (fs * (w - ka | length)) ~ ka ~ ' kWh à ' ~ pr ~ '  \n    EV Sonia:\u00a0' ~ (fs * (w - kb | length)) ~ kb ~ ' kWh à ' ~ ps -%}
  Week {{ d.van }} t/m {{ d.tot }}
  - Netto energiekosten: € {{ f(d.netto) }} (afname € {{ f(d.afname_eur) }} min teruglevering € {{ f(d.teruglevering_eur) }})
  - Inkoopprijs € {{ f(d.inkoopprijs, 3) }}/kWh tegenover marktgemiddelde € {{ f(d.marktprijs, 3) }} ({{ f(d.voordeel_pct, 1, ' %') }} voordeel)
  - Zonnestroom: {{ f(d.opwek_kwh, 0) }} kWh opgewekt, {{ f(d.zelfverbruik_pct, 0, ' %') }} zelf gebruikt, {{ f(d.zelfvoorzienend_pct, 0, ' %') }} zelfvoorzienend
  - Warmtepompcompressor: {{ f(d.wp_kwh, 0) }} kWh, COP {{ f(d.wp_cop) }}, € {{ f(d.wp_prijs, 3) }}/kWh ({{ f(d.wp_voordeel_pct, 1, ' %') }} t.o.v. markt){{ '  ' }}
    Element {{ f(d.element_kwh_warmte, 1) }} kWh warmte
  - Compressor: {{ f(d.compressor_starts, 0) }} starts, gem. run {{ f(d.compressor_gem_run_min, 0, ' min') }}; kamer {{ f(d.kamer_te_koud_pct, 1, ' %') }} van de tijd meer dan 0,5 °C onder setpoint
{{ ev_blok }}
  - Zonder saldering zou deze week € {{ f(d.netto_zonder_saldering) }} kosten (€ {{ f(d.meerkosten_zonder_saldering) }} meer)
{%- endmacro -%}
